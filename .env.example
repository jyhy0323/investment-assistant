# Serper News API Key (https://serper.dev/ 에서 발급받은 키를 여기에 넣으세요)
SERPER_API_KEY=여기에_SERPER_API_키를_입력하세요

# Google AI Studio Gemini API Key (Gemini 2.5 Flash Lite 사용용)
GEMINI_API_KEY=여기에_GEMINI_API_키를_입력하세요

# Flask 개발 모드 활성화 (true 또는 false)
FLASK_DEBUG=true

# 2차 추가 환경변수 (Dify 일반 챗봇 2종 연동)
DIFY_BASE_URL=https://api.dify.ai/v1
DIFY_FUNDAMENTAL_API_KEY=여기에_투자종목분석_Dify_챗봇_API_키를_입력하세요
DIFY_TECHNICAL_API_KEY=여기에_지표해석기_Dify_챗봇_API_키를_입력하세요

# Open DART 전자공시 API Key (https://opendart.fss.or.kr/ 에서 발급)
DART_API_KEY=여기에_DART_API_키를_입력하세요

# KRX 정보데이터시스템 로그인 계정 (https://data.krx.co.kr 회원가입 아이디/비밀번호)
KRX_ID=여기에_KRX_아이디를_입력하세요
KRX_PW=여기에_KRX_비밀번호를_입력하세요

# 웹 앱 접근 비밀번호 (설정 시 로그인 잠금 화면 활성화, 비워두면 잠금 해제)
APP_PASSWORD=여기에_앱_접근_비밀번호를_입력하세요
